<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="26dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_mic" android:contentDescription="@string/ui_1"/>
   <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_2" android:textColor="#203C2D" android:textSize="24sp" android:textStyle="bold" android:layout_marginStart="12dp"/>
   <TextView android:id="@+id/help" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/ui_3" android:textSize="13sp" android:textColor="#55764B" android:clickable="true" android:focusable="true"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="@string/ui_4" android:textSize="35sp" android:textStyle="bold" android:textColor="#1D3327" android:lineSpacingExtra="3dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_5" android:textSize="14sp" android:textColor="#7A8874" android:layout_marginTop="12dp"/>
  <app.pocketmic.LevelView android:id="@+id/level" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="15dp" android:contentDescription="@string/ui_6"/>
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_7" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="#294A32"/>
  <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_8" android:gravity="center" android:textSize="12sp" android:textColor="#83907D" android:layout_marginTop="9dp" android:lineSpacingExtra="4dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="26dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_9" android:textSize="11sp" android:textColor="#809176"/>
   <TextView android:id="@+id/computer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_10" android:textSize="18sp" android:textColor="#26432F" android:textStyle="bold" android:layout_marginTop="9dp"/>
   <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_11" android:textSize="12sp" android:textColor="#7D8B75" android:layout_marginTop="8dp"/>
  </LinearLayout>
  <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="22dp" android:background="@drawable/primary_button" android:backgroundTint="@null" android:text="@string/ui_12" android:textColor="#EEF6E7" android:textSize="16sp" android:stateListAnimator="@null" android:textAllCaps="false"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
   <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/pair" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:background="@android:color/transparent" android:text="@string/ui_13" android:textColor="#5B7650" android:textSize="12sp"/>
   <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/manual" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:background="@android:color/transparent" android:text="@string/ui_14" android:textColor="#5B7650" android:textSize="12sp"/>
   <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:background="@android:color/transparent" android:text="@string/ui_15" android:textColor="#8D6750" android:textSize="12sp" android:visibility="gone"/>
  </LinearLayout>
  <Button android:id="@+id/update" android:layout_width="match_parent" android:layout_height="48dp" android:background="@android:color/transparent" android:text="@string/update_label" android:textSize="11sp" android:textColor="#6F8566"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="10dp" android:gravity="center" android:text="@string/ui_16" android:textColor="#95A08F" android:textSize="11sp"/>
 </LinearLayout>
</ScrollView>
