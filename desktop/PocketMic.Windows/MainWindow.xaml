<Window x:Class="PocketMic.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PocketMic.Windows"
 Title="PocketMic · 随声" Width="1180" Height="860" MinWidth="1060" MinHeight="770" Background="#F5F7F2" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EAF0E5" BorderBrush="#DEE5D9" BorderThickness="0,0,1,0">
   <Grid Margin="22,30,22,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Border Width="44" Height="44" Background="#244B38" CornerRadius="14" HorizontalAlignment="Left"><TextBlock Text="≋" FontSize="34" Foreground="#D7F0B6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border>
     <TextBlock Text="PocketMic" FontSize="23" FontWeight="Bold" Margin="0,15,0,4"/>
     <TextBlock Text="随声 · 让好声音发生" Style="{StaticResource Label}"/>
     <Border Background="#DAE6D1" CornerRadius="9" Padding="14,12" Margin="0,42,0,12"><TextBlock Text="◉   连接工作台" FontWeight="SemiBold" Foreground="#315138"/></Border>
     <Button Content="使用指南  ↗" Background="Transparent" HorizontalContentAlignment="Left" Click="ShowGuide"/>
     <Button x:Name="UpdateButton" Content="检查更新" Background="Transparent" Click="CheckUpdateClicked" Margin="0,8,0,0"/>
     <TextBlock x:Name="UpdateStatus" Text="启动时自动获取更新" FontSize="10" Foreground="#819078" TextWrapping="Wrap" Margin="6,4,6,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Border Background="#F4F7EF" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="只在你的设备之间" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="局域网传输 · 加密连接&#10;无需账号 · 不上传录音" FontSize="11" Foreground="#73826C" LineHeight="21" Margin="0,7,0,0"/></StackPanel></Border>
     <TextBlock x:Name="VersionLabel" Text="WINDOWS" FontSize="10" Foreground="#819078" Margin="5,22,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,28,32,22">
    <DockPanel Margin="0,0,0,24">
     <Border DockPanel.Dock="Right" Background="#E5ECDD" CornerRadius="16" Padding="12,7" VerticalAlignment="Top"><TextBlock x:Name="ConnectionBadge" Text="●  等待手机" FontSize="12" Foreground="#55724D"/></Border>
     <StackPanel><TextBlock Text="你的随身麦克风，已就位。" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="戴上喜欢的耳机，把收音交给手机。" Foreground="#798478" Margin="0,8,0,0" FontSize="13"/></StackPanel>
    </DockPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="22">
      <StackPanel>
       <DockPanel><TextBlock Text="01" DockPanel.Dock="Right" Foreground="#A5B49A" FontSize="13"/><TextBlock Text="连接你的手机" FontWeight="SemiBold" FontSize="17"/></DockPanel>
       <TextBlock Text="打开安卓 PocketMic，扫描下方二维码" Style="{StaticResource Label}" Margin="0,8,0,10"/>
       <Border Background="White" Width="204" Height="204" Padding="3" Margin="0,4,0,4"><Image x:Name="PairQr" Stretch="Uniform" AutomationProperties.Name="手机配对二维码"/></Border>
       <ComboBox x:Name="AddressSelect" SelectionChanged="AddressChanged" AutomationProperties.Name="电脑局域网地址" Margin="0,8,0,0"/>
       <TextBlock Text="手机和电脑连接同一 Wi-Fi 或手机热点" FontSize="11" Foreground="#7B8777" HorizontalAlignment="Center" Margin="0,9,0,12"/>
       <Button Content="复制配对链接" Click="CopyPairing"/>
       <Button Content="重新配对" Background="Transparent" Click="RotatePairing" FontSize="11" Padding="10,8" ToolTip="旧配对将立即失效，需要手机重新扫码"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" Background="#1C3328" CornerRadius="16" Padding="26">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel><TextBlock Text="LIVE AUDIO" Foreground="#A7BEA6" FontSize="11" DockPanel.Dock="Right"/><TextBlock Text="声音，从这里出发" Foreground="#ECF4E6" FontSize="17" FontWeight="SemiBold"/></DockPanel>
       <StackPanel Grid.Row="1" VerticalAlignment="Center">
        <local:WaveformView x:Name="Waveform" Height="125" Margin="0,18,0,20"/>
        <TextBlock x:Name="DeviceLabel" Text="等待第一声「你好」" Foreground="#E1EEDA" FontSize="19" HorizontalAlignment="Center"/>
        <TextBlock x:Name="StreamLabel" Text="手机连接后，这里会显示实时输入" Foreground="#99B297" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>
       <StackPanel Grid.Row="2">
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock x:Name="RttLabel" Text="— ms" Foreground="#DEF1CF" FontSize="24"/><TextBlock Text="网络往返" Foreground="#96AD92" FontSize="11" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock x:Name="BufferLabel" Text="— ms" Foreground="#DEF1CF" FontSize="24"/><TextBlock Text="接收缓冲" Foreground="#96AD92" FontSize="11" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock x:Name="PeakLabel" Text="— dB" Foreground="#DEF1CF" FontSize="24"/><TextBlock Text="输入峰值" Foreground="#96AD92" FontSize="11" Margin="0,5,0,0"/></StackPanel>
        </Grid>
        <Button x:Name="MuteButton" Content="暂停输出" Click="ToggleMute" Background="#C4E79D" Foreground="#233C29" IsEnabled="False"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="24,20">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="刷新设备" Background="Transparent" Padding="8,3" FontSize="11" Click="RefreshDevices"/><TextBlock Text="02   把声音送到电脑" FontSize="16" FontWeight="SemiBold"/></DockPanel>
       <ComboBox x:Name="OutputSelect" SelectionChanged="OutputChanged" Margin="0,13,0,9" AutomationProperties.Name="电脑音频输出设备"/>
       <TextBlock x:Name="OutputHint" Text="检测虚拟音频设备中…" FontSize="11" Foreground="#74816F" TextWrapping="Wrap"/>
       <Button x:Name="DriverButton" Content="自动安装虚拟麦克风" Click="InstallDriverClicked" Background="Transparent" HorizontalAlignment="Left" Padding="0,10,0,0" FontSize="11"/>
       <Button Content="驱动：VB-CABLE · Donationware · 支持作者 ↗" Click="OpenDriverWebsite" Background="Transparent" HorizontalAlignment="Left" Padding="0,8,0,0" FontSize="10"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <DockPanel><TextBlock x:Name="GainLabel" DockPanel.Dock="Right" Text="100%" FontSize="12"/><TextBlock Text="麦克风增益" Style="{StaticResource Label}"/></DockPanel>
       <Slider x:Name="GainSlider" Minimum="0" Maximum="200" Value="100" ValueChanged="GainChanged" Margin="0,12,0,17" AutomationProperties.Name="麦克风增益"/>
       <DockPanel><TextBlock Text="连接偏好" Style="{StaticResource Label}" VerticalAlignment="Center"/><ComboBox x:Name="BufferSelect" Width="160" HorizontalAlignment="Right" SelectionChanged="BufferChanged" SelectedIndex="1" AutomationProperties.Name="音频缓冲策略"><ComboBoxItem Content="低延迟 · 40 ms"/><ComboBoxItem Content="均衡 · 60 ms"/><ComboBoxItem Content="更稳定 · 100 ms"/></ComboBox></DockPanel>
      </StackPanel>
     </Grid>
    </Border>
    <DockPanel Margin="3,16,0,0"><Button Content="导出诊断" DockPanel.Dock="Right" Background="Transparent" FontSize="11" Padding="10,4" Click="ExportDiagnostics"/><TextBlock x:Name="Notice" Text="准备就绪。请允许 Windows 防火墙的「专用网络」访问。" FontSize="11" Foreground="#7F8A79" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
